+@app.post("/v1/chat/count_tokens", response_class=ORJSONResponse, dependencies=[Depends(validate_json_request)])
+async def openai_chat_count_tokens(raw_request: Request):
+    """Measure a complete chat request without generation or scheduler dispatch."""
+    try:
+        payload = await raw_request.json()
+        state = raw_request.app.state
+        if not hasattr(state, "openai_serving_chat_token_count"):
+            state.openai_serving_chat_token_count = OpenAIServingChatTokenCount(state.openai_serving_chat)
+        return await state.openai_serving_chat_token_count.count(payload, raw_request)
+    except ValueError as error:
+        # Validation exception strings may include private prompt/image values.
+        return ORJSONResponse(status_code=400, content={"error": {"type": "TokenCountError", "message": type(error).__name__}})
 
 

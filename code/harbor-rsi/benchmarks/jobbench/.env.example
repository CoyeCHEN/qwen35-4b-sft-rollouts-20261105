# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# `set -a` matters: without it the values are shell variables, not exported
# environment variables, and Harbor's ${VAR} expansion (which reads os.environ
# on the host) will not see them.

# --- E2B sandbox backend -------------------------------------------------
# Required by Harbor's e2b environment. https://e2b.dev
E2B_API_KEY=

# --- OpenHarness agent (the model being evaluated) -----------------------
# The repository's native transport only supports the deepseek provider.
OPEN_HARNESS_MODEL=deepseek/model-name
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenHarness execution settings.
OPEN_HARNESS_REASONING=high
OPEN_HARNESS_CONTEXT_WINDOW=200000
OPEN_HARNESS_MAX_TOKENS=65536

# --- Judge (the model doing the grading) ---------------------------------
# judge.py is OpenAI-compatible: it builds OpenAI(base_url=..., api_key=...).
# These three must reach the *sandbox* environment, which happens through
# task.toml's [verifier.env] ${...} templates.
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=

# Recorded in the judge's report as the model under evaluation.
JOBBENCH_EVALUATED_MODEL=deepseek/model-name

# Rubric-level judge concurrency inside one verifier. Higher = faster but more
# likely to hit provider rate limits.
JOBBENCH_JUDGE_WORKERS=3

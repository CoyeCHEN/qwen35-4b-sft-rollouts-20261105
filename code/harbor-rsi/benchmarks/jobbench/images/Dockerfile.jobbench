# JobBench runtime image for Harbor + E2B.
#
# Why a custom image at all
# -------------------------
# The verifier needs `openai` (judge.py) plus the document stack (pandas /
#      openpyxl / python-docx) to read the deliverables it grades. Installing
#      those at verification time would need network in the verifier phase.
#
# Build:
#   E2B builds this via Harbor's template mechanism — you normally do not run
#   `docker build` yourself. Point the dataset at the pushed tag instead:
#
#     python -m jobbench_e2b.main --base-image <your-registry>/jobbench-e2b:1
#
#   or run `harbor run --env e2b` with a task whose docker_image is that tag.
#   For a purely local check, `docker build -f images/Dockerfile.jobbench .`
#   works too.
#
# Size: E2B template builds are not subject to the Siflow nginx stream limit,
# but keep this lean anyway — every task clone pays the pull cost. LibreOffice
# is the single biggest item and is optional; the judge reads .docx/.xlsx
# through python libs, not through LibreOffice. Add it only if a task's agent
# needs to *produce* those formats and fails without it.

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
USER root

# Runtime + document tooling.
#   - python3/venv: the verifier's interpreter
#   - poppler-utils / qpdf: PDF text extraction
#   - sqlite3: several tasks ship .db fixtures
#   - tesseract: scanned PDFs appear in the source data
#   - jq / file: agent quality-of-life, and used by many task instructions
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        file \
        fonts-dejavu-core \
        fonts-liberation2 \
        git \
        jq \
        libmagic1 \
        poppler-utils \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        qpdf \
        ripgrep \
        fd-find \
        sqlite3 \
        tesseract-ocr \
        tini \
        unzip \
        wget \
        zip \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Debian installs fd as fdfind. OpenHarness accepts either name, and the alias
# also helps shell commands generated by the evaluated model.
RUN ln -s /usr/bin/fdfind /usr/local/bin/fd

# ---------------------------------------------------------------------------
# Verifier venv.
#
# A dedicated venv rather than system python: it makes the interpreter path a
# stable contract (`tests/test.sh` hardcodes /opt/jobbench-venv/bin/python), so
# swapping the base OS does not silently change which packages the judge sees.
# ---------------------------------------------------------------------------
RUN python3 -m venv /opt/jobbench-venv \
    && /opt/jobbench-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/jobbench-venv/bin/pip install --no-cache-dir \
        "openai>=1.60" \
        "pandas>=2.2" \
        "openpyxl>=3.1" \
        "mammoth>=1.8" \
        "python-docx>=1.1" \
        "pypdf>=5.0" \
        "pdfplumber>=0.11"

# NOTE on mammoth: judge.py reads .docx through it, and falls back to a literal
# "[ERROR: mammoth not available for <file>]" string when the import fails. That
# fallback is scored as a failed rubric, so a missing mammoth shows up as a
# uniformly low score rather than an error. It is a hard requirement, not a
# convenience.

# ---------------------------------------------------------------------------
# Agent-side analysis stack.
#
# The *agent* also has to produce .docx/.xlsx deliverables, and judge.py parses
# them out of the same workdir. Installing these into the venv keeps one
# interpreter for both roles, which is what tests/test.sh assumes.
# ---------------------------------------------------------------------------
RUN /opt/jobbench-venv/bin/pip install --no-cache-dir \
        "numpy>=1.26" \
        "scipy>=1.13" \
        "statsmodels>=0.14" \
        "scikit-learn>=1.5" \
        "matplotlib>=3.9" \
        "XlsxWriter>=3.2" \
        "xlrd>=2.0" \
        "python-pptx>=1.0" \
        "reportlab>=4.2" \
        "Pillow>=10.4" \
        "pytesseract>=0.3.13"

# Make the venv the default interpreter without replacing the base interpreter
# that the venv's own python symlink points to.
ENV PATH="/opt/jobbench-venv/bin:${PATH}"

# ---------------------------------------------------------------------------
# Layout.
#
# E2B has no bind-mount concept, so unlike the docker environment Harbor cannot
# conjure these paths by mounting them — the image has to create every directory
# Harbor will later read or write. A missing one is not a graceful failure:
#
#   FileNotFoundException: path not found: lstat /logs: no such file or directory
#
# raised while collecting logs, *after* a trial has already burned its sandbox.
# The full set comes from harbor.models.trial.paths.EnvironmentPaths:
#
#   /logs              /logs/agent     /logs/verifier
#   /logs/artifacts    /tests          /solution
#
# /workspace must match the dataset's [environment].workdir. If you change the
# workdir flag, change it here too.
# ---------------------------------------------------------------------------
RUN mkdir -p /workspace \
             /logs/agent /logs/verifier /logs/artifacts \
             /tests /solution \
    && chmod -R 0777 /workspace /logs /tests /solution

WORKDIR /workspace

# ---------------------------------------------------------------------------
# Build-time smoke test.
#
# Cheap, and it catches the failure mode that otherwise only shows up mid-eval:
# a missing import in the verifier path. Every third-party module judge.py
# imports must appear here — a missing one does not crash the judge, it makes it
# silently score documents as unreadable, which reads as a weak model.
# ---------------------------------------------------------------------------
RUN /opt/jobbench-venv/bin/python -c 'import openai, pandas, openpyxl, docx, mammoth, pypdf, pdfplumber; import numpy, scipy, matplotlib, pptx, reportlab; print("JOBBENCH_E2B_RUNTIME_OK", "openai", openai.__version__, "pandas", pandas.__version__, "openpyxl", openpyxl.__version__)'

# E2B keeps the sandbox alive; this is what its supervisor expects to inherit.
# Anything after the BASE_RECIPE_END marker below is image-only and is dropped
# when this file is used as the base for a self-contained task image (see
# adapter.render_dockerfile).
# BASE_RECIPE_END
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]

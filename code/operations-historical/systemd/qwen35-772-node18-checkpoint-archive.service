[Unit]
Description=Immutable OpenHarness SFT checkpoint archive
StartLimitIntervalSec=60
StartLimitBurst=3
[Service]
Type=oneshot
Environment=OPENHARNESS_SFT_WORKSPACE=/ssd/chenkeyi/qwen35-sft-772-20261101/old-four-arm
Environment=PYTHONPATH=/ssd/chenkeyi/qwen35-sft-772-20261101/old-four-arm/source/repository
ExecStart=/ssd/chenkeyi/qwen35-sft-772-20261101/env/train-r1/bin/python -m sft --workspace /ssd/chenkeyi/qwen35-sft-772-20261101/old-four-arm archive-worker
TimeoutStartSec=2h
MemoryMax=512M
CPUQuota=100%
Nice=10
IOSchedulingClass=idle
UMask=0027
KillMode=control-group
Restart=no
